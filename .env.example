# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real keys.

# Binance API credentials.
# Read by app/bot.py and app/pages/live_chart.py via os.getenv().
# The bot needs these to fetch OHLCV history and to place orders in LIVE mode.
# In TEST mode fills are simulated locally, but the keys are still used for market data.
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_api_secret

# AWS credentials for DynamoDB access.
# Optional: boto3 also picks these up from ~/.aws/credentials or, on EC2,
# from the instance role created by deployment/attach_iam.py.
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=ap-southeast-2
